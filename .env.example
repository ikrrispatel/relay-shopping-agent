# RELAY environment configuration (copy to .env and fill in)

# --- PayPal mode -------------------------------------------------------
# mock  = offline in-process mock (default, no credentials needed)
# live  = PayPal sandbox (https://api-m.sandbox.paypal.com)
PAYPILOT_PAYPAL_MODE=mock

# --- PayPal sandbox credentials (live mode) -----------------------------
# Create a free sandbox REST app at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- LLM brain (optional) ----------------------------------------------
# Any OpenAI-compatible chat endpoint. If unreachable, PayPilot falls back
# to its deterministic offline brain automatically.
PAYPILOT_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
PAYPILOT_LLM_API_KEY=
PAYPILOT_LLM_MODEL=mimo-v2-flash

# --- RELAY sponsor integrations -----------------------------------------
# Senso: official base is https://apiv2.senso.ai/api/v1; X-API-Key auth.
# SENSO_API_KEY=
# SENSO_BASE_URL=https://apiv2.senso.ai/api/v1
# SUPERLINKED_API_KEY=          # or SIE_API_KEY
# SUPERLINKED_SIE_URL=https://api.superlinked.com/v1
# SUPERLINKED_MODEL=            # choose a currently Serverless-supported /score model
# RELAY_REQUIRE_SENSO_EVIDENCE=0  # set 1 to fail closed when retrieval is unavailable
# Firedrill uses OAuth/MCP or its official runner; no repository token is accepted.
# FIREDRILL_PROJECT_ID=
# FIREDRILL_ENVIRONMENT_ID=
# AMPLITUDE_API_KEY=
# AMPLITUDE_ENDPOINT=
